NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>
# Thamani PROD Supabase (separate project from atlas) — read-only source for
# the growth dashboard cron. Server-only; never NEXT_PUBLIC.
THAMANI_SUPABASE_URL=https://lxescgcuelttoxaacsib.supabase.co
THAMANI_SUPABASE_SERVICE_ROLE_KEY=<thamani prod service-role key>
# Public origin used by cron routes, email templates, and server actions.
# Local: http://localhost:3000  |  Prod: https://thamani-atlas.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
CRON_SECRET=<random>
# Enables /auth/test-signin for Playwright fixtures. Never set in production.
ATLAS_TEST_MODE=1
